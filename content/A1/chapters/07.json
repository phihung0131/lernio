s":[],"type":"matchPairs","pairs":[{"left":"die Uhr","right":"giờ, đồng hồ"},{"left":"die Stunde","right":"tiếng (60 phút)"},{"left":"die Minute","right":"phút"},{"left":"halb","right":"rưỡi (nửa giờ trước)"},{"left":"das Viertel","right":"một phần tư (15 phút)"}]},{"id":"a1-c07-l1-e10","explanationVi":"tiếng (60 phút) = die Stunde.","tags":["vocab:a1c07-stunde"],"type":"typeAnswer","prompt":"Gõ từ tiếng Đức có nghĩa “tiếng (60 phút)”","answers":["die Stunde","Stunde"]},{"id":"a1-c07-l1-e11","explanationVi":"phút = die Minute.","tags":["vocab:a1c07-minute"],"type":"typeAnswer","prompt":"Gõ từ tiếng Đức có nghĩa “phút”","answers":["die Minute","Minute"]},{"id":"a1-c07-l1-e12","explanationVi":"halb neun = 8:30.","tags":[],"type":"multipleChoice","prompt":"“halb neun” là mấy giờ?","options":["8:30","9:30","9:00","8:00"],"answer":0},{"id":"a1-c07-l1-e13","explanationVi":"Viertel vor zehn = 9:45.","tags":[],"type":"multipleChoice","prompt":"“Viertel vor zehn” là mấy giờ?","options":["9:45","10:15","10:45","9:15"],"answer":0},{"id":"a1-c07-l1-e14","explanationVi":"10 phút sau 2 giờ.","tags":[],"type":"multipleChoice","prompt":"“zehn nach zwei” là:","options":["2:10","1:50","2:50","12:10"],"answer":0},{"id":"a1-c07-l1-e15","explanationVi":"Câu đúng: Wie spät ist es?","tags":[],"type":"wordOrder","promptVi":"Mấy giờ rồi?","words":["Wie","spät","ist","es?"],"answer":["Wie","spät","ist","es?"]},{"id":"a1-c07-l1-e16","explanationVi":"3:30 = halb vier (nửa giờ trước 4 giờ).","tags":[],"type":"fillBlank","prompt":"Es ist ___ vier. (3:30)","answers":["halb"]},{"id":"a1-c07-l1-e17","explanationVi":"7:00 = sieben Uhr.","tags":[],"type":"typeAnswer","prompt":"Viết 7:00 bằng thân mật (“bảy giờ”)","answers":["sieben Uhr"]},{"id":"a1-c07-l1-e18","explanationVi":"Bạn nghe: halb neun","tags":[],"type":"listenAndChoose","audio":"halb neun","options":["halb neun","neun Uhr","Viertel neun","zehn nach neun"],"answer":0}],"vocab":[{"id":"a1c07-uhr","de":"Uhr","article":"die","plural":"Uhren","pos":"danh từ","vi":"giờ, đồng hồ","viRespelling":"u-ơ","emoji":"🕐","tags":[]},{"id":"a1c07-stunde","de":"Stunde","article":"die","plural":"Stunden","pos":"danh từ","vi":"tiếng (60 phút)","viRespelling":"sờ-tun-đờ","emoji":"⌛","tags":[]},{"id":"a1c07-minute","de":"Minute","article":"die","plural":"Minuten","pos":"danh từ","vi":"phút","viRespelling":"mi-nu-tờ","emoji":"⏱️","tags":[]},{"id":"a1c07-halb","de":"halb","pos":"từ","vi":"rưỡi (nửa giờ trước)","viRespelling":"halp","emoji":"🕧","tags":[]},{"id":"a1c07-viertel","de":"Viertel","article":"das","pos":"danh từ","vi":"một phần tư (15 phút)","viRespelling":"phiếc-tồl","emoji":"🕒","tags":[]},{"id":"a1c07-vor","de":"vor","pos":"giới từ","vi":"kém","viRespelling":"phô-ơ","emoji":"⬅️","tags":[]},{"id":"a1c07-nach","de":"nach","pos":"giới từ","vi":"qua, hơn","viRespelling":"nakh","emoji":"➡️","tags":[]}],"teaches":["uhrzeit"]},{"id":"a1-c07-l2","title":"Ngày trong tuần, tháng, ngày tháng","objectives":["Gọi tên 7 ngày và 12 tháng","Hỏi và nói ngày tháng"],"sections":{"introduction":[{"kind":"text","md":"Ngày và tháng đều có **mạo từ der** (ngày trong tuần, tháng là giống đực). Ngày tháng được viết theo thứ tự **ngày. tháng. năm**."}],"vocabulary":[{"kind":"vocabList","vocabIds":["a1c07-montag","a1c07-dienstag","a1c07-mittwoch","a1c07-donnerstag","a1c07-freitag","a1c07-samstag","a1c07-sonntag","a1c07-heute","a1c07-morgen","a1c07-gestern"]}],"grammar":[{"kind":"table","head":["Tháng","Tiếng Đức","Tháng","Tiếng Đức"],"rows":[["1","Januar","7","Juli"],["2","Februar","8","August"],["3","März","9","September"],["4","April","10","Oktober"],["5","Mai","11","November"],["6","Juni","12","Dezember"]]},{"kind":"text","md":"**Hỏi ngày:** *Welcher Tag ist heute?* – *Heute ist Montag.*\n**Hỏi ngày tháng:** *Der Wievielte ist heute?* – *Heute ist der 15. November.*\n**Trong ngày/ tháng:** dùng **am** (ngày trong tuần, ngày cụ thể): *am Montag*, *am 15. November*; dùng **im** (tháng): *im November*."},{"kind":"callout","tone":"info","md":"**Số thứ tự:** viết số + dấu chấm: **15.** = *der fünfzehnte*. Từ 1 đến 19 thêm **-te**, từ 20 thêm **-ste**. Ngoại lệ: **1. = erste, 3. = dritte, 7. = siebte**."},{"kind":"callout","tone":"tip","md":"Ngày viết theo thứ tự **ngày. tháng. năm**: 15.11.2026 = ngày 15 tháng 11 năm 2026. Tuần của người Đức **bắt đầu từ thứ Hai** (Montag)."}],"examples":[{"kind":"example","de":"Heute ist Montag.","vi":"Hôm nay là thứ Hai."},{"kind":"example","de":"Am Freitag habe ich Deutschkurs.","vi":"Vào thứ Sáu tôi có lớp tiếng Đức."},{"kind":"example","de":"Mein Geburtstag ist am 3. Mai.","vi":"Sinh nhật tôi là ngày 3 tháng 5."},{"kind":"example","de":"Im Dezember ist es kalt.","vi":"Vào tháng 12 trời lạnh."}],"practice":[{"kind":"exercises","exerciseIds":["a1-c07-l2-e1","a1-c07-l2-e2","a1-c07-l2-e3","a1-c07-l2-e4","a1-c07-l2-e5","a1-c07-l2-e6","a1-c07-l2-e7","a1-c07-l2-e8","a1-c07-l2-e9","a1-c07-l2-e10","a1-c07-l2-e11","a1-c07-l2-e12","a1-c07-l2-e13","a1-c07-l2-e14","a1-c07-l2-e15","a1-c07-l2-e16","a1-c07-l2-e17"]}],"review":[{"kind":"text","md":"- Tháng và ngày đều giống **der**.\n- **am** + ngày, **im** + tháng.\n- Thứ tự ngày tháng: ngày.tháng.năm."}]},"exercises":[{"id":"a1-c07-l2-e1","explanationVi":"thứ Hai = der Montag.","tags":["vocab:a1c07-montag"],"type":"multipleChoice","prompt":"“thứ Hai” trong tiếng Đức là gì?","options":["der Montag","morgen","der Donnerstag","gestern"],"answer":0},{"id":"a1-c07-l2-e2","explanationVi":"thứ Ba = der Dienstag.","tags":["vocab:a1c07-dienstag"],"type":"multipleChoice","prompt":"“thứ Ba” trong tiếng Đức là gì?","options":["der Sonntag","der Dienstag","der Montag","heute"],"answer":1},{"id":"a1-c07-l2-e3","explanationVi":"thứ Tư = der Mittwoch.","tags":["vocab:a1c07-mittwoch"],"type":"multipleChoice","prompt":"“thứ Tư” trong tiếng Đức là gì?","options":["der Freitag","morgen","der Mittwoch","der Samstag"],"answer":2},{"id":"a1-c07-l2-e4","explanationVi":"Từ bạn nghe là morgen (ngày mai).","tags":["vocab:a1c07-morgen"],"type":"listenAndCh