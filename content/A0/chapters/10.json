ực hiện một cuộc làm quen hoàn chỉnh","Chọn đúng du/Sie và lời chào"],"sections":{"introduction":[{"kind":"text","md":"Bạn đã có thể chào, giới thiệu, hỏi thăm, cảm ơn, xin lỗi và tạm biệt. Bài này ghép tất cả thành hội thoại hoàn chỉnh."}],"vocabulary":[{"kind":"text","md":"Bài này không giới thiệu từ vựng mới. Hãy tập trung vào phần ngữ pháp và ví dụ."}],"grammar":[{"kind":"table","head":["Chức năng","Thân mật (du)","Lịch sự (Sie)"],"rows":[["Chào","Hallo! / Hi!","Guten Tag!"],["Hỏi tên","Wie heißt du?","Wie heißen Sie?"],["Hỏi quê","Woher kommst du?","Woher kommen Sie?"],["Hỏi thăm","Wie geht’s?","Wie geht es Ihnen?"],["Hỏi lại","Und dir?","Und Ihnen?"],["Tạm biệt","Tschüss! / Bis bald!","Auf Wiedersehen!"]]}],"examples":[{"kind":"dialogue","title":"Ở văn phòng (lịch sự)","lines":[{"speaker":"Frau Weber","de":"Guten Tag! Wie heißen Sie?","vi":"Chào anh! Anh tên là gì?","voice":"f"},{"speaker":"Herr Nguyen","de":"Guten Tag! Mein Name ist Nguyen.","vi":"Chào bà! Tên tôi là Nguyễn.","voice":"m"},{"speaker":"Frau Weber","de":"Woher kommen Sie, Herr Nguyen?","vi":"Anh đến từ đâu, anh Nguyễn?","voice":"f"},{"speaker":"Herr Nguyen","de":"Ich komme aus Vietnam. Und Sie?","vi":"Tôi đến từ Việt Nam. Còn bà?","voice":"m"},{"speaker":"Frau Weber","de":"Ich komme aus Köln. Freut mich!","vi":"Tôi đến từ Köln. Rất vui được gặp!","voice":"f"},{"speaker":"Herr Nguyen","de":"Freut mich auch. Auf Wiedersehen!","vi":"Tôi cũng vậy. Chào tạm biệt!","voice":"m"}]},{"kind":"dialogue","title":"Ở quán cà phê (thân mật)","lines":[{"speaker":"Lea","de":"Hi! Ich bin Lea. Und du?","vi":"Chào! Mình là Lea. Còn bạn?","voice":"f"},{"speaker":"Linh","de":"Hallo Lea! Ich heiße Linh.","vi":"Chào Lea! Mình tên Linh.","voice":"f"},{"speaker":"Lea","de":"Wie geht’s, Linh?","vi":"Khỏe không Linh?","voice":"f"},{"speaker":"Linh","de":"Gut, danke! Und dir?","vi":"Khỏe, cảm ơn! Còn bạn?","voice":"f"},{"speaker":"Lea","de":"Super! Tschüss, bis bald!","vi":"Tuyệt! Tạm biệt, hẹn gặp!","voice":"f"}]}],"practi