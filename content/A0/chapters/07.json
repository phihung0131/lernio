e.","tags":["vocab:a0c07-wie","lesson:a0-c07-l2"],"type":"typeAnswer","prompt":"Gõ từ tiếng Đức có nghĩa “như thế nào, gì”","answers":["wie"]},{"id":"a0-c07-l2-e9","explanationVi":"từ đâu = woher.","tags":["vocab:a0c07-woher","lesson:a0-c07-l2"],"type":"typeAnswer","prompt":"Gõ từ tiếng Đức có nghĩa “từ đâu”","answers":["woher"]},{"id":"a0-c07-l2-e10","explanationVi":"Câu đúng: Wie heißt du?","tags":["lesson:a0-c07-l2"],"type":"wordOrder","promptVi":"Bạn tên gì?","words":["Wie","heißt","du?"],"answer":["Wie","heißt","du?"]},{"id":"a0-c07-l2-e11","explanationVi":"Câu đúng: Ich komme aus Vietnam","tags":["lesson:a0-c07-l2"],"type":"wordOrder","promptVi":"Tôi đến từ Việt Nam","words":["Ich","komme","aus","Vietnam"],"answer":["Ich","komme","aus","Vietnam"]},{"id":"a0-c07-l2-e12","explanationVi":"du kommst.","tags":["lesson:a0-c07-l2"],"type":"fillBlank","prompt":"Woher ___ du? (kommen)","answers":["kommst"]},{"id":"a0-c07-l2-e13","explanationVi":"ich heiße.","tags":["lesson:a0-c07-l2"],"type":"fillBlank","prompt":"Ich ___ Mai. (heißen)","answers":["heiße","heisse"]},{"id":"a0-c07-l2-e14","explanationVi":"Mein Name ist Tom.","tags":["lesson:a0-c07-l2"],"type":"translate","vi":"Tên tôi là Tom.","answers":["Mein Name ist Tom","Ich heiße Tom"]}],"vocab":[{"id":"a0c07-heissen","de":"heißen","pos":"động từ","vi":"tên là","viRespelling":"hai-xần","icon":"IconId","example":{"de":"Ich heiße Linh.","vi":"Tôi tên là Linh."},"tags":[]},{"id":"a0c07-wie","de":"wie","pos":"từ hỏi","vi":"như thế nào, gì","viRespelling":"vi","icon":"IconQuestionMark","example":{"de":"Wie heißt du?","vi":"Bạn tên gì?"},"tags":[]},{"id":"a0c07-woher","de":"woher","pos":"từ hỏi","vi":"từ đâu","viRespelling":"vô-he-ơ","icon":"IconMapPin","example":{"de":"Woher kommst du?","vi":"Bạn đến từ đâu?"},"tags":[]},{"id":"a0c07-kommen","de":"kommen","pos":"động từ","vi":"đến","viRespelling":"kô-mần","icon":"IconWalk","example":{"de":"Ich komme aus Vietnam.","vi":"Tôi đến từ Việt Nam."},"tags":[]},{"id":"a0c07-aus",