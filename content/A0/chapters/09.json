n","lesson:a0-c09-l1"],"type":"typeAnswer","prompt":"Gõ từ tiếng Đức có nghĩa “là (ich)”","answers":["bin"]},{"id":"a0-c09-l1-e10","explanationVi":"ich bin.","tags":["lesson:a0-c09-l1"],"type":"fillBlank","prompt":"Ich ___ Linh.","answers":["bin"]},{"id":"a0-c09-l1-e11","explanationVi":"du bist.","tags":["lesson:a0-c09-l1"],"type":"fillBlank","prompt":"Du ___ nett.","answers":["bist"]},{"id":"a0-c09-l1-e12","explanationVi":"Câu đúng: Bist du Tom?","tags":["lesson:a0-c09-l1"],"type":"wordOrder","promptVi":"Bạn là Tom phải không?","words":["Bist","du","Tom?"],"answer":["Bist","du","Tom?"]},{"id":"a0-c09-l1-e13","explanationVi":"Ich bin hier.","tags":["lesson:a0-c09-l1"],"type":"translate","vi":"Tôi ở đây.","answers":["Ich bin hier"]}],"vocab":[{"id":"a0c09-ich","de":"ich","pos":"đại từ","vi":"tôi","viRespelling":"ích","icon":"IconUser","example":{"de":"Ich bin Linh.","vi":"Tôi là Linh."},"tags":[]},{"id":"a0c09-du","de":"du","pos":"đại từ","vi":"bạn (thân mật)","viRespelling":"đu","icon":"IconUser","example":{"de":"Du bist nett.","vi":"Bạn dễ mến."},"tags":[]},{"id":"a0c09-bin","de":"bin","pos":"động từ","vi":"là (ich)","viRespelling":"bin","icon":"IconEqual","example":{"de":"Ich bin müde.","vi":"Tôi mệt."},"tags":[]},{"id":"a0c09-bist","de":"bist","pos":"động từ","vi":"là (du)","viRespelling":"bist","icon":"IconEqual","example":{"de":"Bist du Tom?","vi":"Bạn là Tom à?"},"tags":[]},{"id":"a0c09-mude","de":"müde","pos":"tính từ","vi":"mệt","viRespelling":"muy-đờ","icon":"IconZzz","example":{"de":"Ich bin müde.","vi":"Tôi mệt."},"tags":[]},{"id":"a0c09-nett","de":"nett","pos":"tính từ","vi":"dễ mến, tốt bụng","viRespelling":"nét","icon":"IconMoodSmile","example":{"de":"Du bist sehr nett.","vi":"Bạn rất dễ mến."},"tags":[]},{"id":"a0c09-student-in","de":"Studentin","article":"die","plural":"Studentinnen","pos":"danh từ","vi":"nữ sinh viên","viRespelling":"sh-tu-đen-tin","icon":"IconSchool","example":{"de":"Ich bin Studentin.","vi":"Tôi là sinh viên."},"tags":[]},{"id":"a