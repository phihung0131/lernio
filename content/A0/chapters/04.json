":"IconHeart","example":{"de":"Die Liebe ist schön.","vi":"Tình yêu đẹp."},"tags":[]},{"id":"a0c04-freund","de":"Freund","article":"der","plural":"Freunde","pos":"danh từ","vi":"người bạn (nam)","viRespelling":"phroi-nt","icon":"IconFriends","example":{"de":"Mein Freund heißt Tom.","vi":"Bạn tôi tên Tom."},"tags":[]},{"id":"a0c04-heute","de":"heute","pos":"trạng từ","vi":"hôm nay","viRespelling":"hoi-tờ","icon":"IconCalendar","example":{"de":"Heute ist Montag.","vi":"Hôm nay là thứ Hai."},"tags":[]},{"id":"a0c04-baume","de":"Bäume","pos":"danh từ số nhiều","vi":"những cái cây","viRespelling":"boi-mờ","icon":"IconTree","example":{"de":"Die Bäume sind grün.","vi":"Cây xanh."},"tags":[]},{"id":"a0c04-haus","de":"Haus","article":"das","plural":"Häuser","pos":"danh từ","vi":"ngôi nhà","viRespelling":"hao-x","icon":"IconHome","example":{"de":"Das Haus ist neu.","vi":"Ngôi nhà mới."},"tags":[]},{"id":"a0c04-frau","de":"Frau","article":"die","plural":"Frauen","pos":"danh từ","vi":"phụ nữ, bà","viRespelling":"phrao","icon":"IconWoman","example":{"de":"Die Frau ist Ärztin.","vi":"Người phụ nữ là bác sĩ."},"tags":[]},{"id":"a0c04-nein","de":"nein","pos":"từ","vi":"không","viRespelling":"nai-n","icon":"IconX","example":{"de":"Nein, danke.","vi":"Không, cảm ơn."},"tags":[]}],"teaches":[]},{"id":"a0-c04-l3","title":"Phụ âm ghép: ch, sch, sp, st, pf, tz","objectives":["Đọc hai kiểu ch","Đọc sch, sp/st đầu từ, pf, tz, ck"],"sections":{"introduction":[{"kind":"text","md":"Tiếng Đức đọc **gần như đúng như viết**. Chỉ cần thuộc vài tổ hợp phụ âm là bạn đọc được hầu hết từ mới."}],"vocabulary":[{"kind":"vocabList","vocabIds":["a0c04-ich","a0c04-milch","a0c04-buch","a0c04-nacht","a0c04-schule","a0c04-sport","a0c04-stadt","a0c04-apfel","a0c04-katze","a0c04-jacke"]}],"grammar":[{"kind":"table","head":["Tổ hợp","Đọc","Ví dụ"],"rows":[["ch sau **a, o, u, au**","“kh” cổ họng","Buch, Nacht, auch"],["ch sau các âm khác","“ích” nhẹ (hơi gió qua lưỡi)","ich, Milch, nicht"],["sch","“s” cong lưỡi 