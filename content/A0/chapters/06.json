o"],"answer":2},{"id":"a0-c06-l2-e6","explanationVi":"Ghép từ tiếng Đức với nghĩa tiếng Việt.","tags":["lesson:a0-c06-l2"],"type":"matchPairs","pairs":[{"left":"Tschüss","right":"tạm biệt (thân mật)"},{"left":"Auf Wiedersehen","right":"tạm biệt (lịch sự)"},{"left":"Auf Wiederhören","right":"tạm biệt (qua điện thoại)"},{"left":"Bis bald","right":"hẹn sớm gặp lại"},{"left":"Bis morgen","right":"hẹn mai gặp"}]},{"id":"a0-c06-l2-e7","explanationVi":"tạm biệt (lịch sự) = Auf Wiedersehen.","tags":["vocab:a0c06-auf-wiedersehen","lesson:a0-c06-l2"],"type":"typeAnswer","prompt":"Gõ từ tiếng Đức có nghĩa “tạm biệt (lịch sự)”","answers":["Auf Wiedersehen"]},{"id":"a0-c06-l2-e8","explanationVi":"tạm biệt (qua điện thoại) = Auf Wiederhören.","tags":["vocab:a0c06-auf-wiederhoren","lesson:a0-c06-l2"],"type":"typeAnswer","prompt":"Gõ từ tiếng Đức có nghĩa “tạm biệt (qua điện thoại)”","answers":["Auf Wiederhören"]},{"id":"a0-c06-l2-e9","explanationVi":"Điện thoại: Auf Wiederhören.","tags":["lesson:a0-c06-l2"],"type":"multipleChoice","prompt":"Kết thúc cuộc gọi lịch sự, bạn nói?","options":["Auf Wiedersehen","Auf Wiederhören","Gute Nacht"],"answer":1},{"id":"a0-c06-l2-e10","explanationVi":"bald = sớm.","tags":["lesson:a0-c06-l2"],"type":"multipleChoice","prompt":"“Bis bald” nghĩa là?","options":["hẹn sớm gặp lại","hẹn mai gặp","chúc ngủ ngon"],"answer":0},{"id":"a0-c06-l2-e11","explanationVi":"Tschüss, bis morgen!","tags":["lesson:a0-c06-l2"],"type":"translate","vi":"Tạm biệt, mai gặp!","answers":["Tschüss, bis morgen","Tschüss bis morgen","Tschüss, bis morgen!"]},{"id":"a0-c06-l2-e12","explanationVi":"Câu đúng: Auf Wiedersehen","tags":["lesson:a0-c06-l2"],"type":"dictation","audio":"Auf Wiedersehen","answers":["Auf Wiedersehen"]}],"vocab":[{"id":"a0c06-tschuss","de":"Tschüss","pos":"lời chào","vi":"tạm biệt (thân mật)","viRespelling":"chuýt-x","icon":"IconHandStop","example":{"de":"Tschüss, bis morgen!","vi":"Tạm biệt, mai gặp!"},"tags":[]},{"id":"a0c06-auf-wiedersehen","de":"Auf Wiedersehen","pos":"lời chào","vi":"tạm biệt (lịch sự)","viRespelling":"ao-f vi-đơ-dê-ần","icon":"IconHandStop","example":{"de":"Auf Wiedersehen, Herr Schmidt!","vi":"Chào tạm biệt ông Schmidt!"},"tags":[]},{"id":"a0c06-auf-wiederhoren","de":"Auf Wiederhören","pos":"lời chào","vi":"tạm biệt (qua điện thoại)","viRespelling":"ao-f vi-đơ-hơ-rần","icon":"IconPhone","example":{"de":"Danke, auf Wiederhören!","vi":"Cảm ơn, chào tạm biệt!"},"tags":[]},{"id":"a0c06-bis-bald","de":"Bis bald","pos":"cụm từ","vi":"hẹn sớm gặp lại","viRespelling":"bis bal-t","icon":"IconClock","example":{"de":"Tschüss, bis bald!","vi":"Tạm biệt, hẹn sớm gặp lại!"},"tags":[]},{"id":"a0c06-bis-morgen","de":"Bis morgen","pos":"cụm từ","vi":"hẹn mai gặp","viRespelling":"bis mo-gần","icon":"IconCalendar","example":{"de":"Bis morgen, Anna!","vi":"Mai gặp nhé Anna!"},"tags":[]},{"id":"a0c06-bis-spater","de":"Bis später","pos":"cụm từ","vi":"hẹn gặp lát nữa","viRespelling":"bis sh-pê-tơ","icon":"IconClock","example":{"de":"Bis später im Café!","vi":"Lát gặp ở quán cà phê nhé!"},"tags":[]},{"id":"a0c06-schones-we","de":"Schönes Wochenende","pos":"lời chúc","vi":"cuối tuần vui vẻ","viRespelling":"sơ-nần vô-khần-en-đờ","icon":"IconCalendar","example":{"de":"Schönes Wochenende, Tom!","vi":"Cuối tuần vui vẻ nhé Tom!"},"tags":[]},{"id":"a0c06-ciao","de":"Ciao","pos":"lời chào","vi":"tạm biệt (thân mật)","viRespelling":"chao","icon":"IconHandStop","example":{"de":"Ciao, bis dann!","vi":"Chào nhé, hẹn gặp!"},"tags":[]}],"teaches":[]},{"id":"a0-c06-l3","title":"Hỏi thăm sức khỏe","objectives":["Hỏi “Bạn khỏe không?” thân mật và lịch sự","Trả lời ở các mức tốt, bình thường, không tốt"],"sections":{"introduction":[{"kind":"text","md":"Sau lời chào, người Đức thường hỏi thăm. Khác với tiếng Anh, người Đức **trả lời thật lòng**, nên “es geht” (tạm được) rất bình thường."}],"vocabulary":[{"kind":"vocabList","vocabIds":["a0c06-wie-gehts","a0c06-wie-geht-es-ihnen","a0c06-gut","a0c06-sehr-gut","a0c06-es-geht","a0c06-nicht-so-gut","a0c06-schlecht","a0c06-und-dir","a0c06-und-ihnen","a0c06-super"]}],"grammar":[{"kind":"table","head":["","Thân mật (du)","Lịch sự (Sie)"],"rows":[["Hỏi","Wie geht’s? / Wie geht es dir?","Wie geht es Ihnen?"],["Hỏi lại","Und dir?","Und Ihnen?"]]},{"kind":"steps","items":[{"title":"Các mức trả lời","md":"**Super! / Sehr gut!** → **Gut, danke.** → **Es geht.** → **Nicht so gut.** → **Schlecht.** Thường thêm **danke** (cảm ơn đã hỏi).","quiz":{"q":"“Es geht” nghĩa là?","options":["rất tốt","tạm được","tệ"],"answer":1,"why":"es geht = tạm được."}},{"title":"Câu đầy đủ","md":"*Mir geht es gut.* = Tôi khỏe. (**mir** = với tôi; cấu trúc này học kỹ ở A2.) Câu ngắn *Gut, danke.* là đủ."},{"title":"Luôn hỏi lại","md":"Lịch sự là **hỏi lại** người kia: *Und dir?* (bạn bè) / *Und Ihnen?* (lịch sự)."}]},{"kind":"callout","tone":"tip","md":"Nếu ai trả lời “nicht so gut”, hãy hỏi thêm **Was ist los?** (Có chuyện gì vậy?)."}],"examples":[{"kind":"dialogue","lines":[{"speaker":"Anna","de":"Hallo Tom! Wie geht’s?","vi":"Chào Tom! Khỏe không?","voice":"f"},{"speaker":"Tom","de":"Gut, danke. Und dir?","vi":"Tốt, cảm ơn. Còn bạn?","voice":"m"},{"speaker":"Anna","de":"Es geht.","vi":"Tạm được.","voice":"f"}]},{"kind":"dialogue","lines":[{"speaker":"Herr Klein","de":"Guten Tag, Frau Weber. Wie geht es Ihnen?","vi":"Chào bà Weber. Bà khỏe không?","voice":"m"},{"speaker":"Frau Weber","de":"Danke, sehr gut. Und Ihnen?","vi":"Cảm ơn, rất khỏe. Còn ông?","voice":"f"},{"speaker":"Herr Klein","de":"Auch gut, danke.","vi":"Cũng khỏe, cảm ơn.","voice":"m"}]}],"practice":[{"kind":"exercises","exerciseIds":["a0-c06-l3-e1","a0-c06-l3-e2","a0-c06-l3-e3","a0-c06-l3-e4","a0-c06-l3-e5","a0-c06-l3-e6","a0-c06-l3-e7","a0-c06-l3-e8","a0-c06-l3-e9","a0-c06-l3-e10","a0-c06-l3-e11","a0-c06-l3-e12","a0-c06-l3-e13"]}],"review":[{"kind":"text","md":"- **Wie geht’s? / Wie geht es Ihnen?**\n- Trả lời: sehr gut, gut, es geht, nicht so gut, schlecht + **danke**.\n- Hỏi lại: **Und dir? / Und Ihnen?**"},{"kind":"speakingTask","prompt":"Đóng vai: hỏi thăm một người bạn rồi hỏi thăm thầy giáo.","model":[{"de":"Wie geht’s? – Gut, danke. Und dir?","vi":"Khỏe không? – Tốt, cảm ơn. Còn bạn?"},{"de":"Wie geht es Ihnen? – Sehr gut, danke. Und Ihnen?","vi":"Thầy khỏe không? – Rất khỏe, cảm ơn. Còn em?"}]}]},"exercises":[{"id":"a0-c06-l3-e1","explanationVi":"Khỏe không? (thân mật) = Wie geht’s?.","tags":["vocab:a0c06-wie-gehts","lesson:a0-c06-l3"],"type":"multipleChoice","prompt":"“Khỏe không? (thân mật)” trong tiếng Đức là gì?","options":["Wie geht’s?","Und Ihnen?","sehr gut","super"],"answer":0},{"id":"a0-c06-l3-e2","explanationVi":"Ông/bà khỏe không? (lịch sự) = Wie geht es Ihnen?.","tags":["vocab:a0c06-wie-geht-es-ihnen","lesson:a0-c06-l3"],"type":"multipleChoice","prompt":"“Ông/bà khỏe không? (lịch sự)” trong tiếng Đức là gì?","options":["schlecht","Wie geht es Ihnen?","Wie geht’s?","Und dir?"],"answer":1},{"id":"a0-c06-l3-e3","explanationVi":"tốt = gut.","tags":["vocab:a0c06-gut","lesson:a0-c06-l3"],"type":"multipleChoice","prompt":"“tốt” trong tiếng Đức là gì?","options":["es geht","Und Ihnen?","gut","nicht so gut"],"answer":2},{"id":"a0-c06-l3-e4","explanationVi":"Từ bạn nghe là Und Ihnen? (Còn ông/bà? (lịch sự)).","tags":["vocab:a0c06-und-ihnen","lesson:a0-c06-l3"],"type":"listenAndChoose","audio":"Und Ihnen?","options":["super","Und Ihnen?","sehr gut","Wie geht’s?"],"answer":1},{"id":"a0-c06-l3-e5","explanationVi":"Từ bạn nghe là super (tuyệt).","tags":["vocab:a0c06-super","lesson:a0-c06-l3"],"type":"listenAndChoose","audio":"super","options":["schlecht","Wie geht es Ihnen?","super","Und dir?"],"answer":2},{"id":"a0-c06-l3-e6","explanationVi":"Ghép từ tiếng Đức với nghĩa tiếng Việt.","tags":["lesson:a0-c06-l3"],"type":"matchPairs","pairs":[{"left":"Wie geht’s?","right":"Khỏe không? (thân mật)"},{"left":"Wie geht es Ihnen?","right":"Ông/bà khỏe không? (lịch sự)"},{"left":"gut","right":"tốt"},{"left":"sehr gut","right":"rất tốt"},{"left":"es geht","right":"tạm được"}]},{"id":"a0-c06-l3-e7","explanationVi":"Ông/bà khỏe không? (lịch sự) = Wie geht es Ihnen?.","tags":["vocab:a0c06-wie-geht-es-ihnen","lesson:a0-c06-l3"],"type":"typeAnswer","prompt":"Gõ từ tiếng Đức có nghĩa “Ông/bà khỏe không? (lịch sự)”","answers":["Wie geht es Ihnen?"]},{"id":"a0-c06-l3-e8","explanationVi":"tốt = gut.","tags":["vocab:a0c06-gut","lesson:a0-c06-l3"],"type":"typeAnswer","prompt":"Gõ từ tiếng Đức có nghĩa “tốt”","answers":["gut"]},{"id":"a0-c06-l3-e9","explanationVi":"Các mức trả lời.","tags":["lesson:a0-c06-l3"],"type":"categorize","prompt":"Xếp theo mức độ.","categories":["tốt","bình thường","không tốt"],"items":[{"text":"sehr gut","category":0},{"text":"es geht","category":1},{"text":"schlecht","category":2},{"text":"super","category":0},{"text":"nicht so gut","category":2}]},{"id":"a0-c06-l3-e10","explanationVi":"Lịch sự: Wie geht es Ihnen?","tags":["lesson:a0-c06-l3"],"type":"multipleChoice","prompt":"Hỏi thăm sếp thế nào?","options":["Wie geht’s?","Wie geht es Ihnen?"],"answer":1},{"id":"a0-c06-l3-e11","explanationVi":"Câu đúng: Gut, danke. Und dir?","tags":["lesson:a0-c06-l3"],"type":"wordOrder","promptVi":"Tốt, cảm ơn. Còn bạn?","words":["Gut,","danke.","Und","dir?"],"answer":["Gut,","danke.","Und","dir?"]},{"id":"a0-c06-l3-e12","explanationVi":"Mir geht es gut.","tags":["lesson:a0-c06-l3"],"type":"translate","vi":"Tôi khỏe.","answers":["Mir geht es gut","Mir geht’s gut","Mir geht's gut"]},{"id":"a0-c06-l3-e13","explanationVi":"Câu đúng: Wie geht es Ihnen?","tags":["lesson:a0-c06-l3"],"type":"dictation","audio":"Wie geht es Ihnen?","answers":["Wie geht es Ihnen?"]}],"vocab":[{"id":"a0c06-wie-gehts","de":"Wie geht’s?","pos":"câu hỏi","vi":"Khỏe không? (thân mật)","viRespelling":"vi gê-tx","icon":"IconQuestionMark","example":{"de":"Hallo Tom, wie geht’s?","vi":"Chào Tom, khỏe không?"},"tags":[]},{"id":"a0c06-wie-geht-es-ihnen","de":"Wie geht es Ihnen?","pos":"câu hỏi","vi":"Ông/bà khỏe không? (lịch sự)","viRespelling":"vi gêt ét i-nần","icon":"IconQuestionMark","example":{"de":"Guten Tag, wie geht es Ihnen?","vi":"Chào ông, ông khỏe không?"},"tags":[]},{"id":"a0c06-gut","de":"gut","pos":"tính từ","vi":"tốt","viRespelling":"gu-t","icon":"IconMoodSmile","example":{"de":"Mir geht es gut.","vi":"Tôi khỏe."},"tags":[]},{"id":"a0c06-sehr-gut","de":"sehr gut","pos":"cụm từ","vi":"rất tốt","viRespelling":"dê-ơ gu-t","icon":"IconMoodHappy","example":{"de":"Sehr gut, danke!","vi":"Rất tốt, cảm ơn!"},"tags":[]},{"id":"a0c06-es-geht","de":"es geht","pos":"cụm từ","vi":"tạm được","viRespelling":"ét gêt","icon":"IconMoodEmpty","example":{"de":"Es geht, danke.","vi":"Tạm được, cảm ơn."},"tags":[]},{"id":"a0c06-nicht-so-gut","de":"nicht so gut","pos":"cụm từ","vi":"không khỏe lắm","viRespelling":"nícht dô gu-t","icon":"IconMoodSad","example":{"de":"Mir geht es nicht so gut.","vi":"Tôi không khỏe lắm."},"tags":[]},{"id":"a0c06-schlecht","de":"schlecht","pos":"tính từ","vi":"tệ","viRespelling":"slếcht","icon":"IconMoodSad","example":{"de":"Das Wetter ist schlecht.","vi":"Thời tiết tệ."},"tags":[]},{"id":"a0c06-und-dir","de":"Und dir?","pos":"câu hỏi","vi":"Còn bạn? (thân mật)","viRespelling":"un-t đi-ơ","icon":"IconArrowBack","example":{"de":"Gut, danke. Und dir?","vi":"Tốt, cảm ơn. Còn bạn?"},"tags":[]},{"id":"a0c06-und-ihnen","de":"Und Ihnen?","pos":"câu hỏi","vi":"Còn ông/bà? (lịch sự)","viRespelling":"un-t i-nần","icon":"IconArrowBack","example":{"de":"Danke, gut. Und Ihnen?","vi":"Cảm ơn, tốt. Còn ông?"},"tags":[]},{"id":"a0c06-super","de":"super","pos":"tính từ","vi":"tuyệt","viRespelling":"du-pơ","icon":"IconStar","example":{"de":"Super, danke!","vi":"Tuyệt, cảm ơn!"},"tags":[]}],"teaches":[]},{"id":"a0-c06-l4","title":"du hay Sie?","objectives":["Chọn đúng du (thân mật) hay Sie (lịch sự)","Nhận ra Sie luôn viết hoa"],"sections":{"introduction":[{"kind":"text","md":"Tiếng Việt có rất nhiều cách xưng hô (anh, chị, em, cô, chú…). Tiếng Đức chỉ có hai: **du** (thân mật) và **Sie** (lịch sự). Chọn sai có thể làm người khác khó chịu."}],"vocabulary":[{"kind":"vocabList","vocabIds":["a0c06-du","a0c06-sie-formal","a0c06-duzen","a0c06-siezen","a0c06-kollege","a0c06-chef","a0c06-kind","a0c06-nachbar"]}],"grammar":[{"kind":"table","head":["Dùng du","Dùng Sie"],"rows":[["Bạn bè, người thân","Người lạ, người lớn tuổi"],["Trẻ em, thanh niên với nhau","Thầy cô (ở trường đại học, lớp người lớn)"],["Đồng nghiệp ở công ty trẻ","Sếp, khách hàng, nhân viên nhà nước"],["Trên mạng xã hội, ứng dụng","Bác sĩ, người bán hàng, cảnh sát"]]},{"kind":"steps","items":[{"title":"Sie luôn viết hoa","md":"**Sie** lịch sự **luôn viết hoa**, kể cả giữa câu. Đi kèm là **Ihnen**, **Ihr** cũng viết hoa.","quiz":{"q":"Câu nào lịch sự?","options":["Wie geht es dir?","Wie geht es Ihnen?"],"answer":1,"why":"Ihnen = dạng lịch sự."}},{"title":"Đi kèm họ hoặc tên","md":"**Sie** + **Herr/Frau + họ**: *Guten Tag, Frau Weber.* **du** + **tên**: *Hallo, Anna.*"},{"title":"Khi không chắc","md":"Hãy dùng **Sie**. Người Đức sẽ đề nghị nếu muốn xưng du: *„Wir können uns duzen.“* (Chúng ta xưng du nhé). Thường người **lớn tuổi hơn** hoặc **cấp trên** đề nghị trước."}]},{"kind":"callout","tone":"warn","md":"Dùng **du** với người lạ lớn tuổi hay nhân viên công quyền có thể bị coi là bất lịch sự."}],"examples":[{"kind":"reading","title":"Im Büro","de":"Das ist Herr Schmidt. Er ist der Chef.\nIch sage Sie zu Herrn Schmidt.\nDas ist Tim. Er ist mein Kollege. Wir sind jung.\nIch sage du zu Tim.","vi":"Đây là ông Schmidt. Ông ấy là sếp.\nTôi xưng Sie với ông Schmidt.\nĐây là Tim. Anh ấy là đồng nghiệp của tôi. Chúng tôi còn trẻ.\nTôi xưng du với Tim.","glossary":[{"de":"der Chef","vi":"sếp"},{"de":"der Kollege","vi":"đồng nghiệp"},{"de":"sagen zu","vi":"nói với"}]},{"kind":"dialogue","lines":[{"speaker":"Herr Schmidt","de":"Frau Nguyen, wir arbeiten jetzt ein Jahr zusammen. Wir können uns duzen. Ich bin Peter.","vi":"Chị Nguyễn, chúng ta làm việc cùng nhau được một năm rồi. Mình xưng du nhé. Tôi là Peter.","voice":"m"},{"speaker":"Frau Nguyen","de":"Gern! Ich bin Linh.","vi":"Rất sẵn lòng! Em là Linh.","voice":"f"}]}],"practice":[{"kind":"exercises","exerciseIds":["a0-c06-l4-e1","a0-c06-l4-e2","a0-c06-l4-e3","a0-c06-l4-e4","a0-c06-l4-e5","a0-c06-l4-e6","a0-c06-l4-e7","a0-c06-l4-e8","a0-c06-l4-e9","a0-c06-l4-e10","a0-c06-l4-e11","a0-c06-l4-e12","a0-c06-l4-e13","a0-c06-l4-e14","a0-c06-l4-e15"]}],"review":[{"kind":"text","md":"- **du**: bạn bè, trẻ em, người thân. **Sie**: người lạ, người lớn tuổi, nơi trang trọng.\n- **Sie / Ihnen / Ihr** luôn viết hoa.\n- Không chắc → dùng **Sie**."},{"kind":"writingTask","prompt":"Viết 2 lời chào: một cho bạn thân, một cho bác sĩ.","hints":[],"model":"Hallo Lea! Wie geht’s?\nGuten Tag, Frau Doktor Weber! Wie geht es Ihnen?","checklist":["Bạn thân: Hallo + tên + Wie geht’s?","Bác sĩ: Guten Tag + Frau/Herr + họ + Wie geht es Ihnen?"]}]},"exercises":[{"id":"a0-c06-l4-e1","explanationVi":"bạn (thân mật) = du.","tags":["vocab:a0c06-du","lesson:a0-c06-l4"],"type":"multipleChoice","prompt":"“bạn (thân mật)” trong tiếng Đức là gì?","options":["du","Sie","der Chef","der Kollege"],"answer":0},{"id":"a0-c06-l4-e2","explanationVi":"ông/bà/anh/chị (lịch sự) = Sie.","tags":["vocab:a0c06-sie-formal","lesson:a0-c06-l4"],"type":"multipleChoice","prompt":"“ông/bà/anh/chị (lịch sự)” trong tiếng Đức là gì?","options":["du","Sie","der Chef","der Kollege"],"answer":1},{"id":"a0-c06-l4-e3","explanationVi":"xưng du với nhau = duzen.","tags":["vocab:a0c06-duzen","lesson:a0-c06-l4"],"type":"multipleChoice","prompt":"“xưng du với nhau” trong tiếng Đức là gì?","options":["du","der Chef","duzen","der Kollege"],"answer":2},{"id":"a0-c06-l4-e4","explanationVi":"Từ bạn nghe là das Kind (đứa trẻ).","tags":["vocab:a0c06-kind","lesson:a0-c06-l4"],"type":"listenAndChoose","audio":"das Kind","options":["du","das Kind","der Kollege","siezen"],"answer":1},{"id":"a0-c06-l4-e5","explanationVi":"Từ bạn nghe là der Nachbar (hàng xóm (nam)).","tags":["vocab:a0c06-nachbar","lesson:a0-c06-l4"],"type":"listenAndCho