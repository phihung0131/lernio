 thuộc phần N–Z.","tags":[],"type":"multipleChoice","prompt":"Chữ cái nào KHÔNG thuộc phần A–M?","options":["K","M","R","F"],"answer":2},{"id":"a0-c02-l1-e5","explanationVi":"Haus = ngôi nhà.","tags":[],"type":"dictation","audio":"Haus","answers":["Haus"]},{"id":"a0-c02-l1-e6","explanationVi":"Thứ tự: …F G H I…","tags":[],"type":"typeAnswer","prompt":"Gõ chữ cái đứng sau G trong bảng chữ cái (viết hoa)","answers":["H","h"]}],"vocab":[],"teaches":[]},{"id":"a0-c02-l2","title":"Chữ cái N đến Z","objectives":["Đọc tên 13 chữ cái còn lại","Chú ý các chữ khác tiếng Việt: R, S, V, W, Z"],"sections":{"introduction":[{"kind":"text","md":"Phần này có nhiều chữ **đọc khác** bạn nghĩ. Đặc biệt **V, W, Z, S**. Hãy nghe kỹ từng chữ."}],"vocabulary":[{"kind":"text","md":"Bài này không giới thiệu từ vựng mới. Hãy tập trung vào phần ngữ pháp và ví dụ."}],"grammar":[{"kind":"pronunciation","letter":"N n","viRespelling":"en","note":"Giống “en”.","audio":"Enn","examples":["Nein (không)","Name (tên)"]},{"kind":"pronunciation","letter":"O o","viRespelling":"ô","note":"Giống “ô”.","audio":"Oh","examples":["Opa (ông)","Ohr (tai)"]},{"kind":"pronunciation","letter":"P p","viRespelling":"pê","note":"Giống “pê”.","audio":"Peh","examples":["Papa (bố)","Pause (nghỉ)"]},{"kind":"pronunciation","letter":"Q q","viRespelling":"ku","note":"Đọc “ku”, luôn đi với u (qu).","audio":"Kuh","examples":["Qualität (chất lượng)"]},{"kind":"pronunciation","letter":"R r","viRespelling":"e-r","note":"Âm “r” ở cổ họng, sẽ học kỹ sau.","audio":"Err","examples":["Rot (đỏ)","Rad (bánh xe)"]},{"kind":"pronunciation","letter":"S s","viRespelling":"ét-s","note":"Tên chữ là “ét-s”. Trong từ thường là âm “z” rung.","audio":"Ess","examples":["Sonne (mặt trời)"]},{"kind":"pronunciation","letter":"T t","viRespelling":"tê","note":"Giống “tê”.","audio":"Teh","examples":["Tisch (cái bàn)","Tag (ngày)"]},{"kind":"pronunciation","letter":"U u","viRespelling":"u","note":"Giống “u”.","audio":"Uh","examples":["Uhr (đồng hồ)","Und 