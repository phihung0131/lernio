nane","article":"die","plural":"Bananen","pos":"danh từ","vi":"quả chuối","viRespelling":"ba-NA-nờ","icon":"IconBanana","example":{"de":"Die Banane ist süß.","vi":"Quả chuối ngọt."},"tags":[]},{"id":"a0c05-familie","de":"Familie","article":"die","plural":"Familien","pos":"danh từ","vi":"gia đình","viRespelling":"pha-MI-li-ờ","icon":"IconUsers","example":{"de":"Meine Familie ist groß.","vi":"Gia đình tôi đông người."},"tags":[]},{"id":"a0c05-telefon","de":"Telefon","article":"das","plural":"Telefone","pos":"danh từ","vi":"điện thoại","viRespelling":"tê-lê-PHÔN","icon":"IconPhone","example":{"de":"Das Telefon ist neu.","vi":"Điện thoại mới."},"tags":[]},{"id":"a0c05-student","de":"Student","article":"der","plural":"Studenten","pos":"danh từ","vi":"sinh viên (nam)","viRespelling":"sh-tu-ĐENT","icon":"IconSchool","example":{"de":"Der Student lernt.","vi":"Sinh viên học bài."},"tags":[]},{"id":"a0c05-fenster","de":"Fenster","article":"das","plural":"Fenster","pos":"danh từ","vi":"cửa sổ","viRespelling":"PHEN-xtơ","icon":"IconWindow","example":{"de":"Das Fenster ist offen.","vi":"Cửa sổ mở."},"tags":[]},{"id":"a0c05-lehrerin","de":"Lehrerin","article":"die","plural":"Lehrerinnen","pos":"danh từ","vi":"giáo viên (nữ)","viRespelling":"LÊ-rơ-rin","icon":"IconSchool","example":{"de":"Die Lehrerin ist nett.","vi":"Cô giáo tốt bụng."},"tags":[]},{"id":"a0c05-kartoffel","de":"Kartoffel","article":"die","plural":"Kartoffeln","pos":"danh từ","vi":"khoai tây","viRespelling":"ca-TÓP-phồl","icon":"IconPlant","example":{"de":"Ich esse eine Kartoffel.","vi":"Tôi ăn một củ khoai tây."},"tags":[]},{"id":"a0c05-morgen","de":"morgen","pos":"trạng từ","vi":"ngày mai","viRespelling":"MO-gần","icon":"IconSunrise","example":{"de":"Bis morgen!","vi":"Hẹn mai gặp!"},"tags":[]},{"id":"a0c05-arbeiten","de":"arbeiten","pos":"động từ","vi":"làm việc","viRespelling":"AR-bai-tần","icon":"IconBriefcase","example":{"de":"Ich arbeite heute.","vi":"Hôm nay tôi làm việc."},"tags":[]},{"id":"a0c05-universit