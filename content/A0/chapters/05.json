05-l2-e2","a0-c05-l2-e3","a0-c05-l2-e4","a0-c05-l2-e5","a0-c05-l2-e6","a0-c05-l2-e7","a0-c05-l2-e8","a0-c05-l2-e9","a0-c05-l2-e10","a0-c05-l2-e11","a0-c05-l2-e12","a0-c05-l2-e13","a0-c05-l2-e14"]}],"review":[{"kind":"text","md":"- Từ ghép = nhiều từ ngắn ghép lại.\n- **Giống theo từ cuối**, **nhấn ở từ đầu**."},{"kind":"writingTask","prompt":"Tách 3 từ ghép và ghi giống: Kühlschrank, Apfelsaft, Schlafzimmer.","hints":[],"model":"Kühl + Schrank → der Kühlschrank\nApfel + Saft → der Apfelsaft\nSchlaf + Zimmer → das Schlafzimmer","checklist":["Tách đúng 2 phần","Giống theo phần cuối"]}]},"exercises":[{"id":"a0-c05-l2-e1","explanationVi":"tủ lạnh = der Kühlschrank.","tags":["vocab:a0c05-kuhlschrank","lesson:a0-c05-l2"],"type":"multipleChoice","prompt":"“tủ lạnh” trong tiếng Đức là gì?","options":["der Kühlschrank","die Hausaufgabe","das Wochenende","der Geburtstag"],"answer":0},{"id":"a0-c05-l2-e2","explanationVi":"bài tập về nhà = die Hausaufgabe.","tags":["vocab:a0c05-hausaufgabe","lesson:a0-c05-l2"],"type":"multipleChoice","prompt":"“bài tập về nhà” trong tiếng Đức là gì?","options":["der Kühlschrank","die Hausaufgabe","das Wochenende","der Geburtstag"],"answer":1},{"id":"a0-c05-l2-e3","explanationVi":"nhà ga = der Bahnhof.","tags":["vocab:a0c05-bahnhof","lesson:a0-c05-l2"],"type":"multipleChoice","prompt":"“nhà ga” trong tiếng Đức là gì?","options":["der Kühlschrank","das Wochenende","der Bahnhof","der Geburtstag"],"answer":2},{"id":"a0-c05-l2-e4","explanationVi":"Từ bạn nghe là der Apfelsaft (nước táo).","tags":["vocab:a0c05-apfelsaft","lesson:a0-c05-l2"],"type":"listenAndChoose","audio":"der Apfelsaft","options":["der Kühlschrank","der Apfelsaft","der Geburtstag","das Handy"],"answer":1},{"id":"a0-c05-l2-e5","explanationVi":"Từ bạn nghe là das Schlafzimmer (phòng ngủ).","tags":["vocab:a0c05-schlafzimmer","lesson:a0-c05-l2"],"type":"listenAndChoose","audio":"das Schlafzimmer","options":["der Kühlschrank","der Geburtstag","das Schlafzimmer","das Handy"],"answer":2},