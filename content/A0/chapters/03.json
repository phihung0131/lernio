c03-l2"],"type":"listenAndChoose","audio":"der Vogel","options":["schön","mögen","der Vogel","Köln"],"answer":2},{"id":"a0-c03-l2-e6","explanationVi":"das Öl. Học danh từ luôn kèm mạo từ.","tags":["vocab:a0c03-ol","lesson:a0-c03-l2"],"type":"articlePick","noun":"Öl","answer":"das"},{"id":"a0-c03-l2-e7","explanationVi":"die Tochter. Học danh từ luôn kèm mạo từ.","tags":["vocab:a0c03-tochter","lesson:a0-c03-l2"],"type":"articlePick","noun":"Tochter","answer":"die"},{"id":"a0-c03-l2-e8","explanationVi":"der Vogel. Học danh từ luôn kèm mạo từ.","tags":["vocab:a0c03-vogel","lesson:a0-c03-l2"],"type":"articlePick","noun":"Vogel","answer":"der"},{"id":"a0-c03-l2-e9","explanationVi":"Ghép từ tiếng Đức với nghĩa tiếng Việt.","tags":["lesson:a0-c03-l2"],"type":"matchPairs","pairs":[{"left":"schön","right":"đẹp"},{"left":"das Öl","right":"dầu"},{"left":"hören","right":"nghe"},{"left":"Köln","right":"thành phố Köln"},{"left":"mögen","right":"thích"}]},{"id":"a0-c03-l2-e10","explanationVi":"dầu = das Öl.","tags":["vocab:a0c03-ol","lesson:a0-c03-l2"],"type":"typeAnswer","prompt":"Gõ từ tiếng Đức có nghĩa “dầu”","answers":["das Öl","Öl"]},{"id":"a0-c03-l2-e11","explanationVi":"nghe = hören.","tags":["vocab:a0c03-horen","lesson:a0-c03-l2"],"type":"typeAnswer","prompt":"Gõ từ tiếng Đức có nghĩa “nghe”","answers":["hören"]},{"id":"a0-c03-l2-e12","explanationVi":"ê + môi tròn = ö.","tags":["lesson:a0-c03-l2"],"type":"multipleChoice","prompt":"Cách nói ö đúng là?","options":["Nói “ô” rồi bẹt môi","Nói “ê” rồi tròn môi","Nói “u”"],"answer":1},{"id":"a0-c03-l2-e13","explanationVi":"schön = đẹp; schon = đã.","tags":["lesson:a0-c03-l2"],"type":"multipleChoice","prompt":"“schön” nghĩa là gì?","options":["đã","đẹp","nghe"],"answer":1},{"id":"a0-c03-l2-e14","explanationVi":"Bạn nghe: schön","tags":["lesson:a0-c03-l2"],"type":"listenAndChoose","audio":"schön","options":["schon","schön"],"answer":1},{"id":"a0-c03-l2-e15","explanationVi":"ö = oe.","tags":["lesson:a0-c03-l2"],"type":"typeAnswer",