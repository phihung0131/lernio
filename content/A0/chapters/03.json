i":"đôi bàn tay","viRespelling":"hen-đờ","icon":"IconHandStop","example":{"de":"Meine Hände sind kalt.","vi":"Tay tôi lạnh."},"tags":[]},{"id":"a0c03-apfel-pl","de":"Äpfel","pos":"danh từ số nhiều","vi":"những quả táo","viRespelling":"ép-phồl","icon":"IconApple","example":{"de":"Die Äpfel sind rot.","vi":"Những quả táo màu đỏ."},"tags":[]},{"id":"a0c03-spat","de":"spät","pos":"tính từ","vi":"muộn","viRespelling":"sờ-pết","icon":"IconClock","example":{"de":"Es ist spät.","vi":"Muộn rồi."},"tags":[]},{"id":"a0c03-tag","de":"Tag","article":"der","plural":"Tage","pos":"danh từ","vi":"ngày","viRespelling":"tak","icon":"IconSun","example":{"de":"Der Tag ist schön.","vi":"Ngày đẹp."},"tags":[]},{"id":"a0c03-nachste","de":"nächste","pos":"tính từ","vi":"tiếp theo","viRespelling":"nếch-xtờ","icon":"IconArrowRight","example":{"de":"Die nächste Stunde","vi":"Tiết học tiếp theo"},"tags":[]}],"teaches":[]},{"id":"a0-c03-l2","title":"Umlaut Ö","objectives":["Phát âm ö bằng kỹ thuật “ê tròn môi”","Phân biệt o và ö"],"sections":{"introduction":[{"kind":"text","md":"**ö** là âm không có trong tiếng Việt. Nhưng bạn có thể tạo ra nó dễ dàng: **nói “ê” rồi chu môi tròn như nói “ô”**."}],"vocabulary":[{"kind":"vocabList","vocabIds":["a0c03-schon","a0c03-ol","a0c03-horen","a0c03-koln","a0c03-mogen","a0c03-offnen","a0c03-tochter","a0c03-vogel"]}],"grammar":[{"kind":"pronunciation","letter":"Ö ö","viRespelling":"ơ tròn môi","note":"Nói “ê”, giữ lưỡi nguyên chỗ, rồi chu tròn môi như nói “ô”. Âm phát ra là ö.","audio":"schön","examples":["schön","Öl","hören"]},{"kind":"steps","items":[{"title":"Kỹ thuật 3 bước","md":"1. Nói **“ê”** kéo dài.\n2. **Không** di chuyển lưỡi.\n3. Từ từ **chu tròn môi**. Âm thanh đổi thành **ö**.","quiz":{"q":"Để nói ö, lưỡi đặt ở vị trí âm nào?","options":["ê","a","u"],"answer":0,"why":"Lưỡi ở vị trí “ê”, môi tròn."}},{"title":"o và ö","md":"**o** = “ô” (Vogel), **ö** = “ê tròn môi” (Vögel = những con chim). *schon* (đã) và *schön* (đẹp) là hai từ khác nhau!"},{"t